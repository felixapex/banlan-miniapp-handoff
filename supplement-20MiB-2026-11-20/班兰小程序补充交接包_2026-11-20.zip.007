        /**
         * 接口调用失败的回调函数
         */
        fail?: WriteNdefMessageFailCallback;
        /**
         * 二进制对象数组, 需要指明 id, type 以及 payload (均为 ArrayBuffer 类型)
         */
        records?: any[];
        /**
         * 接口调用成功的回调函数
         */
        success?: WriteNdefMessageSuccessCallback;
        /**
         * text 数组
         */
        texts?: any[];
        /**
         * uri 数组
         */
        uris?: any[];
    }

