        complete?: OpenHKOfflinePayViewCompleteCallback;
        /**
         * 接口调用失败的回调函数
         */
        fail?: OpenHKOfflinePayViewFailCallback;
        /**
         * 签名算法，应与后台下单时的值一致，目前仅支持 SHA1
         *
         * 可选值：
         * - 'SHA1': SHA1签名算法;
         */
        signType?: "SHA1";
        /**
         * 接口调用成功的回调函数
         */
        success?: OpenHKOfflinePayViewSuccessCallback;
    }

