         * 文档: [https://developers.weixin.qq.com/miniprogram/dev/api/device/nfc/NfcV.close.html](https://developers.weixin.qq.com/miniprogram/dev/api/device/nfc/NfcV.close.html)
         */
        close(option?: NdefCloseOption): void;
        /**
         *
         * 需要基础库： `2.11.2`
