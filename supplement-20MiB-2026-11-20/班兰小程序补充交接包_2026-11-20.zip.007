        disableSwitchVoice?: boolean;
        /**
         * 接口调用失败的回调函数
         */
        fail?: Join1v1ChatFailCallback;
        /**
         * 小窗样式
         */
        minWindowType?: number;
        /**
         * 通话类型
         *
         * 可选值：
         * - 'voice': 语音通话;
         * - 'video': 视频通话;
