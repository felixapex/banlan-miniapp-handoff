        /**
         * 收款用户 openId， 对应传入的商户 appId 下，某用户的 openId
         */
        openId?: string;
        /**
         * 子商户 appId，服务商模式下，appId 和 subAppId 二选一填写
         */
        subAppId?: string;
        /**
         * 子商户号，服务商模式下必填
         */
        subMchId?: string;
        /**
         * 接口调用成功的回调函数
         */
