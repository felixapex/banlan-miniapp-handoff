    /**
     * 接口调用失败的回调函数
     */
    type WriteNdefMessageFailCallback = (res: Nfcrwerror) => void;
    /**
     * 接口调用成功的回调函数
     */
    type WriteNdefMessageSuccessCallback = (res: Nfcrwerror) => void;

