    errMsg: string;
    uniIdRedirectUrl: string;
  }

  interface UniCloudRefreshTokenEvent {
    token: string;
    tokenExpired: number;
  }

  interface UniCloud {
    /** 事件回调 */
    on(eventName: string, callback: (result: any) => void): void;
    /**
     * 监听云函数、云对象、clientDB的响应
