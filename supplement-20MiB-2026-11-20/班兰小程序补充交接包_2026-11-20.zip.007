     *
     * 文档: [https://uniapp.dcloud.io/uniCloud/cf-database?id=or](https://uniapp.dcloud.io/uniCloud/cf-database?id=or)
     */
    or(__expressions__: any): LogicCommand;
  }
  type GetTempQuery = object;

  /**
