     *
     * 文档: [https://uniapp.dcloud.io/uniCloud/jql?id=groupby](https://uniapp.dcloud.io/uniCloud/jql?id=groupby)
     */
    groupField(projection: string | string.DBFieldString): Query;
  }

  interface CollectionReference {
    name: string;
    /**
