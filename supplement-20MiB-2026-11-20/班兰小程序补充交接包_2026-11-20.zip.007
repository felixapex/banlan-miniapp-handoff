     * 参考: [http://www.html5plus.org/doc/zh_cn/oauth.html](http://www.html5plus.org/doc/zh_cn/oauth.html)
     */
    disabledColor?: string;
    /**
     * 按钮宽度
     * 格式为“XXpx"，默认值为自适应，距离屏幕左右"32px"。
     *
     * 参考: [http://www.html5plus.org/doc/zh_cn/oauth.html](http://www.html5plus.org/doc/zh_cn/oauth.html)
     */
    width?: string;
    /**
     * 按钮高度
     * 格式为“XXpx"，默认值为"94px"。
     *
     * 参考: [http://www.html5plus.org/doc/zh_cn/oauth.html](http://www.html5plus.org/doc/zh_cn/oauth.html)
