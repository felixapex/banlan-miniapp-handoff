         */
        package: string;
        /**
         * 签名，具体见微信支付文档
         */
        paySign: string;
        /**
         * 时间戳，从 1970 年 1 月 1 日 00:00:00 至今的秒数，即当前的时间
         */
        timeStamp: string;
        /**
         * 接口调用结束的回调函数（调用成功、失败都会执行）
