    type ReadFileCompleteCallback = (res: FileError) => void;
    /**
     * 接口调用失败的回调函数
     */
    type ReadFileFailCallback = (res: FileError) => void;

    interface ReadFileSuccessCallbackResult {
        /**
         * 文件内容
