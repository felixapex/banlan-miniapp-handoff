␀␀␀␀Òcs]␀␀␀␀[␀␀[␀␀Ä␀ ␀banlan-supplement-2026-11-20/workspace/packages/banlan-miniapp-frontend/node_modules/min-document/event/remove-event-listener.jsUT␀¶{˛jÿ5␀k•{˛jux␀␀␀␀␀␀␀␀␀module.exports = removeEventListener

function removeEventListener(type, listener) {
    var elem = this

    if (!elem.listeners) {
        return
    }

    if (!elem.listeners[type]) {
        return
    }

    var list = elem.listeners[type]
    var index = list.indexOf(listener)
    if (index !== -1) {
        list.splice(index, 1)
    }
}
