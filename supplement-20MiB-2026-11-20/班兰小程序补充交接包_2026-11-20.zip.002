		bgWhite: init("\x1b[47m", "\x1b[49m"),

		blackBright: init("\x1b[90m", "\x1b[39m"),
		redBright: init("\x1b[91m", "\x1b[39m"),
		greenBright: init("\x1b[92m", "\x1b[39m"),
