<html>
    <head>
        <title>Jimp browser example 1</title>
    </head>
    <body>
        
        <!-- Demonstrates loading a local file using Jimp on the main thread -->
        <script src="../lib/jimp.min.js"></script>
        <script>
            
        function dropShadow(x, y, b, a) {
