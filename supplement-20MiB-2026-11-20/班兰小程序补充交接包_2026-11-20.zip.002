            "count": 2,
            "estimatedModuleSize": 8,
            "x": 36,
            "y": 36,
          },
          {
            "count": 2,
            "estimatedModuleSize": 8,
            "x": 148,
            "y": 36,
          }
        ]
      });
      done();
    };
    qr.decode({height: img.height(), width: img.width(), data: img._imgBuffer});
  });
});
