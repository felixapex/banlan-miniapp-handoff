␀␀␀␀Âcs]␀␀␀␀ ␀␀ ␀␀p␀ ␀banlan-supplement-2026-11-20/workspace/packages/banlan-miniapp-frontend/node_modules/es-define-property/index.jsUT␀è{˛j«5␀ké{˛jux␀␀␀␀␀␀␀␀␀'use strict';

/** @type {import('.')} */
var $defineProperty = Object.defineProperty || false;
if ($defineProperty) {
	try {
		$defineProperty({}, 'a', { value: 1 });
	} catch (e) {
		// IE 8 has a broken defineProperty
		$defineProperty = false;
	}
}

module.exports = $defineProperty;
