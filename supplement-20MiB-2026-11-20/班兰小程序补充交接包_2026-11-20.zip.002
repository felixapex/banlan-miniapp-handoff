PKΩ˝„éG␀␀G␀␀PK␀␀␀␀␀‰cs]␀␀␀␀␀␀␀␀␀␀␀␀f␀ ␀banlan-supplement-2026-11-20/workspace/packages/banlan-miniapp-frontend/node_modules/dom-walk/example/UT␀å{˛j_J␀kå{˛jux␀␀␀␀␀␀␀␀␀PK
␀␀␀␀‰cs]␀␀␀␀„␀␀„␀␀f␀ ␀banlan-supplement-2026-11-20/workspace/packages/banlan-miniapp-frontend/node_modules/dom-walk/index.jsUT␀å{˛j”5␀kå{˛jux␀␀␀␀␀␀␀␀␀var slice = Array.prototype.slice

module.exports = iterativelyWalk

function iterativelyWalk(nodes, cb) {
    if (!('length' in nodes)) {
        nodes = [nodes]
    }
    
    nodes = slice.call(nodes)

    while(nodes.length) {
        var node = nodes.shift(),
            ret = cb(node)

        if (ret) {
            return ret
        }

        if (node.childNodes && node.childNodes.length) {
            nodes = slice.call(node.childNodes).concat(nodes)
        }
    }
}
