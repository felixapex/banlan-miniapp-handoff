␀␀␀␀‰cs]␀␀␀␀Y␀␀Y␀␀}␀ ␀banlan-supplement-2026-11-20/workspace/packages/banlan-miniapp-frontend/node_modules/min-document/event/add-event-listener.jsUT␀å{˛jÿ5␀kå{˛jux␀␀␀␀␀␀␀␀␀module.exports = addEventListener

function addEventListener(type, listener) {
    var elem = this

    if (!elem.listeners) {
        elem.listeners = {}
    }

    if (!elem.listeners[type]) {
        elem.listeners[type] = []
    }

    if (elem.listeners[type].indexOf(listener) === -1) {
        elem.listeners[type].push(listener)
    }
}
