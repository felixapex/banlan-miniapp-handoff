    }

    if (helpCallback) {
      sections = helpCallback(sections) || sections;
    }

    console.log(sections.map(section => {
      return section.title ? `${section.title}:\n${section.body}` : section.body;
    }).join('\n\n'));
  }

  outputVersion() {
    const {
      name
    } = this.cli;
    const {
