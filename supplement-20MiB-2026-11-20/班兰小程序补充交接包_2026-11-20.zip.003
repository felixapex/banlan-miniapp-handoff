      sections.push({
        title: 'Options',
        body: options.map(option => {
          return `  ${padRight(option.rawName, longestOptionName.length)}  ${option.description} ${option.config.default === undefined ? '' : `(default: ${option.config.default})`}`;
        }).join('\n')
