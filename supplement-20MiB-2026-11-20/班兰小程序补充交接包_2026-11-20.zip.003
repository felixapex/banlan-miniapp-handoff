    const showCommands = (this.isGlobalCommand || this.isDefaultCommand) && commands.length > 0;

    if (showCommands) {
      const longestCommandName = findLongest(commands.map(command => command.rawName));
      sections.push({
        title: 'Commands',
        body: commands.map(command => {
