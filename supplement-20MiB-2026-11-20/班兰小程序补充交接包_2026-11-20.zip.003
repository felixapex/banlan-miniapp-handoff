    console.log("height",decoder.height);
    console.log("fileSize:",decoder.fileSize);


    //encode with 24bit
    var encodeData = coder.encode(decoder);
    fs.writeFileSync(src+"_out.bmp", encodeData.data);
}

console.log("test bmp success!");










