␀␀␀␀õcs]␀␀␀␀H␀␀H␀␀v␀ ␀banlan-supplement-2026-11-20/workspace/packages/banlan-miniapp-frontend/node_modules/@babel/parser/bin/babel-parser.jsUT␀®{þj6␀k®{þjux␀␀␀␀␀␀␀␀␀#!/usr/bin/env node
/* eslint no-var: 0 */

var parser = require("..");
var fs = require("fs");

var filename = process.argv[2];
if (!filename) {
  console.error("no filename specified");
} else {
  var file = fs.readFileSync(filename, "utf8");
  var ast = parser.parse(file);

  console.log(JSON.stringify(ast, null, "  "));
}
