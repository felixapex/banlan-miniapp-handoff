export function decodeInteger(reader: StringReader): number {
  let value = 0;
  let shift = 0;
  let integer = 0;

  do {
    const c = reader.next();
    integer = charToInt[c];
    value |= (integer & 31) << shift;
    shift += 5;
  } while (integer & 32);

  return value;
}

