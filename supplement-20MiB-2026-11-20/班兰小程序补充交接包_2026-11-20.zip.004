  it('Affect opaque image with a smaller gray mask', () => {
    imgSrcOpaq
      .clone()
      .mask(maskGraySmall)
      .getJGDSync()
      .should.be.sameJGD({
        width: 6,
        height: 4,
        data: [
          0xff000000,
          0xffffff33,
          0x0000ff66,
          0xffffff99,
          0x000000ff,
          0xffffffff,
          0x00000033,
          0xff000066,
          0x00000099,
          0x0000ffcc,
          0x000000ff,
