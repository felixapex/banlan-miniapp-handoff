␀␀␀␀+ds]␀␀␀␀Ÿ␀␀Ÿ␀␀Œ␀ ␀banlan-supplement-2026-11-20/workspace/packages/banlan-miniapp-frontend/node_modules/@vue/babel-plugin-resolve-type/node_modules/.bin/parserUT␀|þj|þj|þjux␀␀␀␀␀␀␀␀␀#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@babel/parser/bin/babel-parser.js" "$@"
else 
  exec node  "$basedir/../@babel/parser/bin/babel-parser.js" "$@"
fi
PKí¢OmŸ␀␀Ÿ␀␀PK
␀␀␀␀+ds]␀␀␀␀R␀␀R␀␀␀ ␀banlan-supplement-2026-11-20/workspace/packages/banlan-miniapp-frontend/node_modules/@vue/babel-plugin-resolve-type/node_modules/.bin/parser.cmdUT␀|þj|þj|þjux␀␀␀␀␀␀␀␀␀@ECHO off
GOTO start
:find_dp0
SET dp0=%~dp0
EXIT /b
:start
SETLOCAL
CALL :find_dp0

IF EXIST "%dp0%\node.exe" (
  SET "_prog=%dp0%\node.exe"
