  "name": "@jridgewell/source-map",
  "version": "0.3.11",
  "description": "Packages @jridgewell/trace-mapping and @jridgewell/gen-mapping into the familiar source-map API",
  "keywords": [
    "sourcemap",
    "source",
    "map"
  ],
  "main": "dist/source-map.umd.js",
