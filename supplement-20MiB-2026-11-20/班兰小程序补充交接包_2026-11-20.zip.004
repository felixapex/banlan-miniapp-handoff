interface Cover {
  cover(w: number, h: number, cb?: ImageCallback<this>): this;
  cover(w: number, h: number, alignBits?: number, cb?: ImageCallback<this>): this;
  cover(
    w: number,
    h: number,
    alignBits?: number,
    mode?: string,
    cb?: ImageCallback<this>
  ): this;
}

export default function(): Cover;
