␀␀␀␀ds]␀␀␀␀␀␀␀␀j␀ ␀banlan-supplement-2026-11-20/workspace/packages/banlan-miniapp-frontend/node_modules/@jimp/tiff/index.d.tsUT␀ß{þj’5␀kß{þjux␀␀␀␀␀␀␀␀␀import { DecoderFn, EncoderFn } from '@jimp/core';

interface Tiff {
  mime: { 'image/tiff': string[] }
  decoders: {
    'image/tiff': DecoderFn
  }
  encoders: {
    'image/tiff': EncoderFn
  }
  constants: {
    MIME_TIFF: 'image/tiff';
  }
}

export default function(): Tiff;
