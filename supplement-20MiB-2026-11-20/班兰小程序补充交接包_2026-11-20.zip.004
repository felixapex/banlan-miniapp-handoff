 c[i] = 1;\n  }\n\n  c[0] = 1 / Math.sqrt(2.0);\n}\n\nfunction applyDCT(f, size) {\n  const N = size;\n  const F = [];\n\n  for (let u = 0; u < N; u++) {\n    F[u] = [];\n    for (let v = 0; v < N; v++) {\n      let sum = 0;\n      for (let i = 0; i < N; i++) {\n        for (let j = 0; j < N; j++) {\n          sum +=\n            Math.cos(((2 * i + 1) / (2.0 * N)) * u * Math.PI) *\n            Math.cos(((2 * j + 1) / (2.0 * N)) * v * Math.PI) *\n            f[i][j];\n        }\n      }\n\n      sum *= (c[u] * c[v]) / 4;\n      F[u][v] = sum;\n    }\n  }\n\n  return F;\n}\n\nmodule.exports = ImagePHash;\n"],"file":"phash.js"}PK&®Ö(␀␀Ö(␀␀PK
