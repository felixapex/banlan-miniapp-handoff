          return
        }

        if (this.pageData == PAGE_MODE_ADD) {
          this.pagination.current++
        }

        this.get(null)
      },
      refresh() {
        this.clear()
        this.get(null)
      },
      clear() {
        this.isEnded = false
        this.dataList.length = 0
      },
      reset() {
        this.pagination.current = 1
      },
      async get(options? : UniCloudDBComponentLoadDataOptions | null) : Promise<void> {
