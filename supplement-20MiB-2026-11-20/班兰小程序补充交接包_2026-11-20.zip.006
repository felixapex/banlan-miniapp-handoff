      end   : "^[ \t]*#+[ \t]*#endexclude[ \t]*\n?"
    },
    extend : {
      start : "^[ \t]*#+[ \t]*#extend(?!able)[ \t]+(.*?)\n+",
      end   : "^[ \t]*#+[ \t]*#endextend[ \t]*\n?"
    },
    extendable : "^[ \t]*#+[ \t]*#extendable[ \t]*$",
    if : {
      start : "^[ \t]*#+[ \t]*#(ifndef|ifdef|if)[ \t]+(.*?)[ \t]*\n+",
      end   : "^[ \t]*#+[ \t]*#endif[ \t]*\n?"
    },
    else : "^[ \t]*#+[ \t]*#else[ \t]*\n?",
    foreach : {
      start : "^[ \t]*#+[ \t]*#foreach[ \t]+(.*?)[ \t]*\n+",
      end   : "^[ \t]*#+[ \t]*#endfor[ \t]*\n?"
    }
  }
};

