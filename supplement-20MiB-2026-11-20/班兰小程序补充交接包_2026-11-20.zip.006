          ),
          'process.env.UNI_SOCKET_PORT': JSON.stringify(
            isProd ? '' : process.env.UNI_SOCKET_PORT
          ),
          'process.env.UNI_SOCKET_ID': JSON.stringify(
            isProd ? '' : process.env.UNI_SOCKET_ID
