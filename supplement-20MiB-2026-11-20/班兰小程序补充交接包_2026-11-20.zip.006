    /**
     * ÂçäÂ±èÂµåÂÖ•ÊâìÂºÄ wx.openEmbeddedMiniProgram
     * @param {Object} openOptions ÊâìÂºÄÂèÇÊï∞
     * @param {Object} plugin uniad-plugin ÂÆû‰æã
     */
    _openHalfScreenEmbeddedInHost (openOptions, plugin) {
